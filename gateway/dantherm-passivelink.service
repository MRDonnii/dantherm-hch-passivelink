[Unit]
Description=Dantherm HCH PassiveLink read-only RS485 gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=passivelink
Group=passivelink
SupplementaryGroups=dialout
WorkingDirectory=/opt/dantherm-passivelink
ExecStart=/opt/dantherm-passivelink/venv/bin/python /opt/dantherm-passivelink/passivelink_gateway.py --device /dev/serial/by-id/REPLACE_WITH_YOUR_ADAPTER --bind 0.0.0.0 --port 4196
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
